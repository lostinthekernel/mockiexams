::dns-port:: Which port does DNS use? {
  =53 # Correct.
  ~67
  ~443
  ####DNS uses 53/UDP, and TCP for large responses.
}

::rfc1918:: Which ranges are private (RFC 1918)? {
  ~%50%10.0.0.0/8
  ~%50%192.168.0.0/16
  ~%-100%8.8.8.0/24
}

